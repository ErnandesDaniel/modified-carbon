@startuml
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam dpi 150

top to bottom direction

actor "Meth\n(Клиент)" as METH
usecase "Регистрация\nи аутентификация" as UC01
usecase "Просмотр\nстатуса кейса" as UC02
usecase "Скачивание\nсертификатов" as UC03
METH --> UC01
METH --> UC02
METH --> UC03

actor "Sleeve\nBroker" as BROKER
usecase "Учёт инвентаря\nsleeves" as UC04
usecase "Отслеживание\nкультивирования" as UC05
usecase "Резервирование\nsleeve" as UC06
usecase "Календарь\nопераций" as UC07
BROKER --> UC04
BROKER --> UC05
BROKER --> UC06
BROKER --> UC07

actor "Needlecaster" as NEEDLE
usecase "Календарь\nопераций" as UC08
usecase "Реестр\nстеков" as UC09
usecase "Мониторинг\nneedlecast" as UC10
usecase "Тестирование\nпосле пробуждения" as UC11
NEEDLE --> UC08
NEEDLE --> UC09
NEEDLE --> UC10
NEEDLE --> UC11

actor "Psychosurgeon" as PSYCHO
usecase "72-часовое\nнаблюдение" as UC12
usecase "Сертификация\nсовместимости" as UC13
usecase "Диагностика\nпроблем" as UC14
PSYCHO --> UC12
PSYCHO --> UC13
PSYCHO --> UC14

actor "Администратор" as ADMIN
usecase "Управление\nпользователями" as UC15
usecase "Контракты\nи оплаты" as UC16
usecase "Онбординг\nклиентов" as UC17
usecase "Генерация\nотчётов" as UC18
usecase "Просмотр\nаудит-лога" as UC19
ADMIN --> UC15
ADMIN --> UC16
ADMIN --> UC17
ADMIN --> UC18
ADMIN --> UC19

@enduml
