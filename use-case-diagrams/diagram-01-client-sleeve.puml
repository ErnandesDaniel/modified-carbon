@startuml
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam dpi 200
skinparam defaultFontName Arial
skinparam defaultFontSize 12

left to right direction

title Use Case Diagram — Модуль клиентов и оболочек

rectangle "SCMS — Модуль управления\nклиентами и оболочками" {

  usecase "Регистрация и\nаутентификация" as AUTH
  usecase "Просмотр\nстатуса кейса" as STATUS
  usecase "Скачивание\nсертификатов" as CERTS
  usecase "Управление\nпрофилем" as PROFILE

  usecase "Учет инвентаря\nsleeves" as INVENTORY
  usecase "Отслеживание\nкультивирования" as CULTIVATION
  usecase "Резервирование\nsleeve" as RESERVATION
  usecase "Ведение мед.\nкарты sleeve" as MEDCARD
  usecase "Управление\nкалендарем операций" as CALENDAR
  usecase "Поиск по\nсистеме" as SEARCH

  CERTS ..> AUTH : <<include>>
  STATUS ..> AUTH : <<include>>
  PROFILE ..> AUTH : <<include>>
  RESERVATION ..> AUTH : <<include>>
}

actor "Meth\n(Клиент)" as METH
actor "Sleeve\nBroker" as BROKER

METH -- AUTH
METH -- STATUS
METH -- CERTS
METH -- PROFILE

BROKER -- INVENTORY
BROKER -- CULTIVATION
BROKER -- RESERVATION
BROKER -- MEDCARD
BROKER -- CALENDAR
BROKER -- SEARCH

@enduml
