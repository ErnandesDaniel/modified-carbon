@startuml
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam dpi 200
skinparam defaultFontName Arial
skinparam defaultFontSize 12

left to right direction

title Use Case Diagram — Модуль нейро-операций

rectangle "SCMS — Модуль нейро-операций\n(перенос и валидация)" {

  usecase "Управление\nреестром стеков" as STACKS
  usecase "Мониторинг\nneedlecast" as MONITOR
  usecase "Тестирование\nпосле пробуждения" as WAKETEST
  usecase "Управление\nкалендарем операций" as CALENDAR

  usecase "72-часовая\nвалидация" as VALIDATE
  usecase "Сертификация\nсовместимости" as CERTIFY
  usecase "Диагностика проблем\nпереноса" as DIAGNOSE
  usecase "Ведение мед.\nкарты sleeve" as MEDCARD
}

actor "Needlecaster" as NEEDLE
actor "Psycho-\nsurgeon" as PSYCHO

NEEDLE -- STACKS
NEEDLE -- MONITOR
NEEDLE -- WAKETEST
NEEDLE -- CALENDAR

PSYCHO -- VALIDATE
PSYCHO -- CERTIFY
PSYCHO -- DIAGNOSE
PSYCHO -- MEDCARD

@enduml
