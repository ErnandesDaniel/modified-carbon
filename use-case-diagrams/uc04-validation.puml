@startuml
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam dpi 200
skinparam defaultFontName Arial
skinparam defaultFontSize 12

left to right direction

title UC-04 — Валидация и сертификация (ValidateAndCertify)

rectangle "SCMS — Валидация" {

  usecase "Провести\nосмотр клиента" as EXAM
  usecase "Подтвердить\nуспех" as OK
  usecase "Зафиксировать\nосложнение" as COMP
  usecase "Сгенерировать\nсертификат PDF" as PDF

  COMP ..> EXAM : <<extend>>
  PDF ..> OK : <<include>>
}

actor "Psychosurgeon" as PSY
actor "Meth" as METH
actor "Администратор" as ADMIN

PSY -- EXAM
PSY -- OK
PSY -- COMP
METH -- PDF
ADMIN -- COMP

@enduml
