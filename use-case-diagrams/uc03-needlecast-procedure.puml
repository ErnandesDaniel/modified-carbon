@startuml
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam dpi 200
skinparam defaultFontName Arial
skinparam defaultFontSize 12

left to right direction

title UC-03 — Проведение процедуры needlecast (ConductNeedlecast)

rectangle "SCMS — Процедура переноса" {

  usecase "Начать\nперенос" as START
  usecase "Отметить\nрезультат" as RESULT
  usecase "Зафиксировать\nинцидент" as INCIDENT

  INCIDENT ..> RESULT : <<extend>>
}

actor "Needlecaster" as NC
actor "Psychosurgeon" as PSY
actor "Meth" as METH

NC -- START
NC -- RESULT
NC -- INCIDENT
PSY -- RESULT
METH -- RESULT

@enduml
