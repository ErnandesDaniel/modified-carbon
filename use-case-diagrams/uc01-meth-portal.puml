@startuml
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam dpi 200
skinparam defaultFontName Arial
skinparam defaultFontSize 12

left to right direction

title UC-01 — Заказ sleeve клиентом (OrderSleeve)

rectangle "SCMS — Портал Meth" {

  usecase "Просмотр каталога\nтел" as CATALOG
  usecase "Фильтрация по\nпараметрам" as FILTER
  usecase "Заказ\nсвободного тела" as ORDER
  usecase "Предзаказ\nклонированного тела" as PREORDER
  usecase "Отслеживание\nстатуса культивирования" as TRACK
  usecase "Скачивание\nсертификата" as CERT

  CATALOG ..> FILTER : <<include>>
  ORDER ..> CATALOG : <<include>>
  PREORDER ..> CATALOG : <<include>>
  PREORDER ..> ORDER : <<extend>>
  CERT ..> TRACK : <<extend>>
}

actor "Meth\n(Клиент)" as METH

METH -- CATALOG
METH -- ORDER
METH -- PREORDER
METH -- TRACK
METH -- CERT

@enduml
