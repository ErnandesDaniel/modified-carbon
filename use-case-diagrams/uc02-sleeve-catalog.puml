@startuml
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam dpi 200
skinparam defaultFontName Arial
skinparam defaultFontSize 12

left to right direction

title UC-02 — Управление жизненным циклом sleeve (ManageSleeveLifecycle)

rectangle "SCMS — Управление sleeves" {

  usecase "Заказ\nкультивирования" as CULTIVATE
  usecase "Приёмка\nтела" as ACCEPT
  usecase "Резервирование\nза клиентом" as RESERVE
  usecase "Просмотр\nкаталога" as CATALOG
  usecase "Ошибка\nкультивирования\n(CultivationFailed)" as CULT_FAIL
  usecase "Проверка\nдубликатов\n(DuplicateCheck)" as DUP_CHECK

  CULTIVATE ..> CATALOG : <<include>>
  RESERVE ..> CATALOG : <<include>>
  CULT_FAIL ..> CULTIVATE : <<extend>>
  DUP_CHECK ..> RESERVE : <<extend>>
}

actor "Sleeve\nBroker" as BROKER
actor "Meth" as METH
rectangle "Генетический\nархив" as GA

BROKER -- CULTIVATE
BROKER -- ACCEPT
BROKER -- RESERVE
BROKER -- CATALOG
GA -- CULTIVATE
METH -- RESERVE

@enduml
