@startuml
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam dpi 200
skinparam defaultFontName Arial
skinparam defaultFontSize 12

left to right direction

title UC-02 — Управление жизненным циклом sleeve (ManageSleeveLifecycle)

rectangle "SCMS — Управление sleeves" {

  usecase "Заказ\nкультивирования" as CULTIVATE
  usecase "Приёмка\nтела" as ACCEPT
  usecase "Резервирование\nза клиентом" as RESERVE
  usecase "Просмотр\nкаталога" as CATALOG

  ACCEPT ..> CULTIVATE : <<extend>>
  RESERVE ..> CATALOG : <<include>>
}

actor "Sleeve\nBroker" as BROKER
actor "Meth" as METH
rectangle "Генетический\nархив" as GA

BROKER -- CULTIVATE
BROKER -- ACCEPT
BROKER -- RESERVE
BROKER -- CATALOG
GA -- CULTIVATE
METH -- RESERVE

@enduml
