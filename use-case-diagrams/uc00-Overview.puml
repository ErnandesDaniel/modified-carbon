@startuml
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam dpi 200
skinparam defaultFontName Arial
skinparam defaultFontSize 12

' Актеры-люди (слева)
actor "Meth\n(Клиент)" as METH
actor "Sleeve Broker\n(Брокер тел)" as BROKER
actor "Needlecaster\n(Оператор переноса)" as NC
actor "Psychosurgeon\n(Психохирург)" as PSY

METH -[hidden]down-> BROKER
BROKER -[hidden]down-> NC
NC -[hidden]down-> PSY

' Внешние системы (справа)
actor "Google OAuth\n<<System>>" as GOOGLE
actor "Генетический архив\n<<System>>" as GA

GOOGLE -[hidden]down-> GA

' Граница системы SCMS
rectangle "SCMS — Sleeving Clinic Management System" as SCMS {

  ' Параллельный стартовый уровень
  together {
    usecase "UC-05: Регистрация клиента\n(RegisterMeth)" as UC05
    usecase "UC-02: Пополнение резерва тел\n(ManageSleeveReserve)" as UC02
  }

  ' Основной поток
  usecase "UC-01: Заказ тела клиентом\n(OrderSleeve)" as UC01
  usecase "UC-03: Проведение переноса\n(ConductNeedlecast)" as UC03
  usecase "UC-04: Осмотр и сертификация\n(ExamineAndCertify)" as UC04

  UC05 -[hidden]down-> UC02

  UC05 -[hidden]right-> UC01
  UC02 -[hidden]right-> UC01
  UC01 -[hidden]right-> UC03
  UC03 -[hidden]right-> UC04

  ' Зависимости (хвост у того, кто зависит)
  UC01 ..> UC05
  UC01 ..> UC02
  UC03 ..> UC01
  UC04 ..> UC03
}

METH -[hidden]right-> SCMS
SCMS -[hidden]right-> GOOGLE

' Связи актеров с прецедентами
METH -- UC05
METH -- UC01
METH -- UC03
METH -- UC04

BROKER -- UC01
BROKER -- UC02

NC -- UC03
PSY -- UC04

UC05 -- GOOGLE
UC02 -- GA

@enduml
