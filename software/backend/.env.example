# 0. Профиль Spring: dev (локально) / prod
SPRING_PROFILES_ACTIVE=dev

# 1. Порт backend
APP_PORT=3001

# 2. PostgreSQL (данные администратора — контейнер + Liquibase)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scms
ADMIN_DB_USERNAME=postgres
ADMIN_DB_PASSWORD=postgres

# 3. Данные приложения (app_user, только DML)
APP_DB_USERNAME=app_user
APP_DB_PASSWORD=app_secret_password_123

# 4. pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PG_ADMIN_PORT=8081

# 5. JWT (httpOnly cookie)
AUTH_SECRET=change-me-please-change-me-please-32b
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# 6. Google OAuth (https://console.cloud.google.com)
# redirect URI должен быть зарегистрирован в Google Console.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/login/oauth2/code/google

# 7. GitHub OAuth (опционально, https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/login/oauth2/code/github

# 8. Куда редиректить после входа (внешний портал Meth)
FRONTEND_BASE_URL=http://localhost:3000

# 9. Cookie/proxy
COOKIE_SECURE=false
FORWARD_HEADERS_STRATEGY=none
