# ============================================================
# SCMS BACKEND CONFIGURATION
# ============================================================
APP_PORT=3001

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scms

# --- ADMIN USER (PostgreSQL superuser) ---
ADMIN_DB_USERNAME=postgres
ADMIN_DB_PASSWORD=postgres

# --- APPLICATION USER (created automatically by init-db.sh) ---
APP_DB_USERNAME=app_user
APP_DB_PASSWORD=app_secret_password_123

# ============================================================
# PGADMIN CONFIGURATION
# ============================================================
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PG_ADMIN_PORT=8081

# ============================================================
# SECURITY
# ============================================================
# Shared HS256 secret between backend and the client-portal proxy.
AUTH_SECRET=z7R4vN1mX5qJ0bY8zP9kL2w7R4vN1mX5
# Secret header used by NextAuth signIn callback to call /auth/login.
SERVICE_AUTHORIZATION_SECRET=my-test-secret-key

# ============================================================
# CORS / FRONTEND
# ============================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
