# ============================================================
# SPRING BOOT CONFIGURATION
# ============================================================
SPRING_PROFILES_ACTIVE=local
JAVA_OPTS=-Xmx512m
APP_PORT=3001

# ============================================================
# SERVICE URLS (for Docker network)
# ============================================================
DB_HOST=localhost
DB_PORT=5432
OLLAMA_URL=http://localhost:11434
SPRING_AI_OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# --- ADMIN USER (PostgreSQL superuser) ---
# Используется для:
# - Инициализации PostgreSQL контейнера (POSTGRES_USER)
# - Выполнения Liquibase миграций (spring.liquibase.user)
# - Создания пользователя приложения и выдачи прав
ADMIN_DB_USERNAME=postgres
ADMIN_DB_PASSWORD=1331

# --- APPLICATION USER ---
# Используется для:
# - Подключения приложения к БД (spring.datasource.username)
# - Выполнения SQL запросов из приложения
# Создается автоматически при старте контейнера через init-db.sh
APP_DB_USERNAME=app_user
APP_DB_PASSWORD=app_secret_password_123

# --- DATABASE CONNECTION ---
# DB_HOST and DB_PORT are defined above in SERVICE URLS section
DB_NAME=notes_ai

# ============================================================
# PGADMIN CONFIGURATION
# ============================================================
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=1331
PG_ADMIN_PORT=8081

# ============================================================
# SECURITY
# ============================================================
AUTH_SECRET=z7R4vN1mX5qJ0bY8zP9kL2w7R4vN1mX5
SERVICE_AUTHORIZATION_SECRET=my-test-secret-key

# ============================================================
# CORS / FRONTEND
# ============================================================
ALLOWED_ORIGINS=http://localhost:3000

# ============================================================
# OLLAMA CONFIGURATION
# ============================================================
OLLAMA_HOST=0.0.0.0
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=1
# OLLAMA_URL is defined above in SERVICE URLS section

# Модель для embeddings (можно менять без пересборки):
# - bge-m3: 1024 dim, MTEB ~72%, размер ~2.3GB, поддержка Dense + Sparse (текущая)
# - mxbai-embed-large: 1024 dim, MTEB ~67%, размер ~1.2GB
# - snowflake-arctic-embed:335m: 1024 dim, MTEB ~68%, размер ~669MB, 2K context
# - nomic-embed-text: 768 dim, MTEB ~62%, размер ~270MB, 8K context
OLLAMA_EMBEDDING_MODEL=bge-m3
